# sshd for attaching to the container from an IDE. Dropped into /etc/ssh/sshd_config.d/;
# it does not replace the image's default config, only extends it.

# Host keys come from a mount rather than being generated into the image: otherwise every
# container recreate changes the fingerprint and the IDE meets
# "REMOTE HOST IDENTIFICATION HAS CHANGED".
HostKey /etc/ssh/keys/ssh_host_ed25519_key
HostKey /etc/ssh/keys/ssh_host_rsa_key

# root has no password at all — only a key from authorized_keys.
PermitRootLogin prohibit-password
PasswordAuthentication no

# /root/.ssh is mounted from the host, where it belongs to the human rather than to root
# inside the container — StrictModes refuses the login over that ("bad ownership or modes").
# Relaxing it is safe: the only way in is a key, and the port listens on 127.0.0.1.
StrictModes no

# An IDE keeps dozens of channels in one session (terminals, LSP, port forwards).
MaxSessions 50
