# One .env per project. Names stay short — no <user>_<goal> prefixes: env_file feeds this
# file and nothing else, so another instance's token can never appear in this container.

# Telegram bot token from @BotFather. One token per sandbox: the allowlist is per process,
# so a single bot cannot be shared between sandboxes.
TG_BOT_TOKEN=

# Telegram user id allowed to talk to this instance. Everyone else is ignored.
TG_ALLOWED_USER_ID=

# Host directory holding this sandbox's credentials and workspace: /root (claude config,
# sessions, IDE backends), the ssh key, host keys, projects, bot.db. Lives outside
# the repository on purpose — the container can be recreated without touching any of it.
USER_DATA=/home/<user>/user_data/<project>

# The claude-bot checkout: the base skills and CLAUDE.md are mounted from there.
CLAUDE_BOT=/home/<user>/claude-bot

TZ=Europe/Lisbon

# Commit authorship in this sandbox, per project — a work repository usually wants its own
# address. entrypoint writes them to /root/.gitconfig on first start if the file is absent.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Under root `--permission-mode bypassPermissions` hits the same check as
# --dangerously-skip-permissions. Root is needed for the docker daemon and the user cannot
# be lowered, so the check is lifted the only way available.
IS_SANDBOX=1
