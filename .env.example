# Environment for one bot instance. This repository ships no instance of its own —
# copy this next to the compose file that runs yours (see README, "Running it").

# Telegram bot token from @BotFather.
TG_BOT_TOKEN=

# Telegram user id allowed to talk to this instance. Everyone else is ignored.
TG_ALLOWED_USER_ID=

# Host directory holding this instance's credentials and workspace: claude config,
# ssh key, gitconfig, projects, wiki. Lives outside the repo on purpose — the
# service can be recreated without touching the human's data.
USER_DATA=/home/<user>/user_data/<name>

# Commit authorship inside the container. The entrypoint writes them to
# /root/.gitconfig on first start if the file is not there yet.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Under root `--permission-mode bypassPermissions` hits the same check as
# --dangerously-skip-permissions. Root is needed for the docker socket or daemon,
# so the check is lifted the only way available.
IS_SANDBOX=1
