# Telegram bot token from @BotFather.
TG_BOT_TOKEN=

# Telegram user id allowed to talk to this instance. Everyone else is ignored.
TG_ALLOWED_USER_ID=

# Host directory holding this instance's credentials and workspace: claude config,
# ssh key, gitconfig, projects, wiki. Lives outside the repo on purpose — the
# service can be recreated without touching the human's data.
USER_DATA=/home/<user>/user_data/<name>/assistant

# Repository the assistant shares with the human on the host, mounted at
# /projects/localhome. Same .git on both sides, see group_add in docker-compose.yml.
HOST_REPO=/home/<user>/localhome

# Group id owning that repository on the host, so the bot's commits stay writable
# for the human. Defaults to 1000.
HOST_GID=1000
